<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
    Premium Apple-Style "V" Icon for VEXO
    Design: Liquid Glass + 3D Hyperrealism
    Palette: Luxury Black + Gold + White
    Style: iOS 17 glassmorphism with depth
    -->

    <!-- Ambient occlusion (deep shadow base) -->
    <path
        android:pathData="M54,72 L35,36 L42,36 L54,60 L66,36 L73,36 Z"
        android:fillColor="#000000"
        android:fillAlpha="0.4" />

    <!-- Outer glow (gold radiance) -->
    <path
        android:pathData="M54,70 L36,38 L43,38 L54,59 L65,38 L72,38 Z"
        android:fillColor="#FFD700"
        android:fillAlpha="0.18" />

    <!-- Main V shape with premium glass gradient -->
    <path
        android:pathData="M54,68 L38,38 L44,38 L54,58 L64,38 L70,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="38"
                android:endX="54"
                android:endY="68"
                android:type="linear">
                <!-- Frosted glass white to golden champagne -->
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#FFFBF5" android:offset="0.15" />
                <item android:color="#FFF8EC" android:offset="0.35" />
                <item android:color="#FFE4B5" android:offset="0.65" />
                <item android:color="#FFD700" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left edge chrome highlight (light source from top-left) -->
    <path
        android:pathData="M40,40 L42,40 L43,42 L44,44 L45,48 L46,52 L47,56 L48,60 L49,64 L50,66 L48,66 L47,62 L46,58 L45,54 L44,50 L43,46 L42,43 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55" />

    <!-- Right edge chrome highlight -->
    <path
        android:pathData="M68,40 L66,40 L65,42 L64,44 L63,48 L62,52 L61,56 L60,60 L59,64 L58,66 L60,66 L61,62 L62,58 L63,54 L64,50 L65,46 L66,43 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35" />

    <!-- Top inner glow (backlight effect) -->
    <path
        android:pathData="M54,40 L63,36 L54,53 L45,36 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4" />

    <!-- Frosted glass overlay (glassmorphism) -->
    <path
        android:pathData="M54,68 L40,42 L43,42 L54,61 L65,42 L68,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="42"
                android:endX="54"
                android:endY="68"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#80FFFFFF" android:offset="0.3" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden metallic accent (left stroke) -->
    <path
        android:pathData="M38,38 L54,68"
        android:strokeWidth="1.2"
        android:strokeColor="#FFD700"
        android:strokeAlpha="0.5"
        android:fillColor="#00000000" />

    <!-- Golden metallic accent (right stroke) -->
    <path
        android:pathData="M54,68 L70,38"
        android:strokeWidth="1.2"
        android:strokeColor="#FFD700"
        android:strokeAlpha="0.5"
        android:fillColor="#00000000" />

    <!-- Specular highlight (sharp catch light at tip) -->
    <path
        android:pathData="M54,66 L52,64 L54,62 L56,64 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />

    <!-- Inner diamond detail (geometric precision) -->
    <path
        android:pathData="M54,44 L56,48 L54,52 L52,48 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5" />

    <!-- Subtle reflection line (3D depth) -->
    <path
        android:pathData="M46,52 L54,63 L62,52"
        android:strokeWidth="0.8"
        android:strokeColor="#FFE4B5"
        android:strokeAlpha="0.3"
        android:fillColor="#00000000"
        android:strokeLineCap="round" />
</vector>
